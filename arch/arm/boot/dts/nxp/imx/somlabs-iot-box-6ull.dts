#include "visionsom-6ull-emmc.dtsi"

/ {
        model = "SoMLabs IoT-BOX-6ULL";

        /delete-node/ pxp_v4l2;

        chosen {
                stdout-path = &uart1;
        };

        leds {
                compatible = "gpio-leds";

                sys-led {
                        label = "SYS_LED";
                        gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
                        linux,default-trigger = "heartbeat";
                };

                user-led-c {
                        label = "USER_LED_C";
                        gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
                };

                user-led-d {
                        label = "USER_LED_D";
                        gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
                };

                user-led-a {
                        label = "USER_LED_A";
                        gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
                };

                user-led-b {
                        label = "USER_LED_B";
                        gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
                };
        };

        regulators {
                reg_usb_otg1_vbus: regulator@1 {
                        compatible = "regulator-fixed";
                        reg = <0>;
                        pinctrl-names = "default";
                        pinctrl-0 = <&pinctrl_usb_otg1_vbus_en>;
                        regulator-name = "usb_otg1_vbus";
                        regulator-min-microvolt = <5000000>;
                        regulator-max-microvolt = <5000000>;
                        gpio = <&gpio1 4 GPIO_ACTIVE_HIGH>;
                        enable-active-high;
                };

                reg_usb_otg2_vbus: regulator@2 {
                        compatible = "regulator-fixed";
                        reg = <1>;
                        regulator-name = "usb_otg2_vbus";
                        regulator-min-microvolt = <5000000>;
                        regulator-max-microvolt = <5000000>;
                };

                reg_3v3: regulator@3 {
                        compatible = "regulator-fixed";
                        reg = <2>;
                        regulator-name = "3v3";
                        regulator-min-microvolt = <3300000>;
                        regulator-max-microvolt = <3300000>;
                };
        };
};

&can1 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_flexcan1>;
        xceiver-supply = <&reg_3v3>;
        status = "okay";
};

&fec1 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_enet1>;
        phy-mode = "rmii";
        phy-handle = <&ethphy0>;
        status = "okay";

        mdio {
                #address-cells = <1>;
                #size-cells = <0>;

                ethphy0: ethernet-phy@1 {
                        compatible = "ethernet-phy-ieee802.3-c22";
                        reg = <1>;
                        clocks = <&clks IMX6UL_CLK_ENET_REF>;
                        clock-names = "rmii-ref";
                };
        };
};

&i2c1 {
        clock_frequency = <100000>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_i2c1>;
        status = "okay";

        rtc: pcf85263@51 {
            compatible = "nxp,pcf85363";
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_rtc_int>;
            reg = <0x51>;
            interrupt-parent = <&gpio1>;
            interrupts = <25 IRQ_TYPE_EDGE_FALLING>;
        };

};

&pxp {
        status = "disabled";
};

&uart1 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_uart1>;
        status = "okay";
};

&uart4 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_uart4>;
        status = "okay";
};

&uart5 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_uart5>;
        linux,rs485-enabled-at-boot-time;
        //rs485-rx-during-tx;
        rts-gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
        status = "okay";
};

&uart8 {
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_uart8>;
        fsl,dte-mode;
        status = "okay";
};

&usbotg1 {
        vbus-supply = <&reg_usb_otg1_vbus>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_usb_otg1_id>;
        dr_mode = "otg";
        status = "okay";
};

&usbotg2 {
        vbus-supply = <&reg_usb_otg2_vbus>;
        dr_mode = "host";
        status = "okay";
};

&usbphy1 {
        tx-d-cal = <0x5>;
};

&usbphy2 {
        tx-d-cal = <0x5>;
};

&iomuxc {
        pinctrl-0 = <&pinctrl_hog_1>;

        somlabs-iot-box-6ull {
                pinctrl_enet1: enet1grp {
                        fsl,pins = <
                                MX6UL_PAD_GPIO1_IO07__ENET1_MDC         0x1b0b0
                                MX6UL_PAD_GPIO1_IO06__ENET1_MDIO        0x1F829
                                MX6UL_PAD_ENET1_RX_EN__ENET1_RX_EN      0x1b0b0
                                MX6UL_PAD_ENET1_RX_ER__ENET1_RX_ER      0x1b0b0
                                MX6UL_PAD_ENET1_RX_DATA0__ENET1_RDATA00 0x1b0b0
                                MX6UL_PAD_ENET1_RX_DATA1__ENET1_RDATA01 0x1b0b0
                                MX6UL_PAD_ENET1_TX_EN__ENET1_TX_EN      0x1b0b0
                                MX6UL_PAD_ENET1_TX_DATA0__ENET1_TDATA00 0x1b0b0
                                MX6UL_PAD_ENET1_TX_DATA1__ENET1_TDATA01 0x1b0b0
                                MX6UL_PAD_ENET1_TX_CLK__ENET1_REF_CLK1  0x400010a9
                                MX6UL_PAD_ENET2_RX_EN__GPIO2_IO10       0x1b0b0
                                MX6UL_PAD_LCD_DATA15__GPIO3_IO20        0x1b001
                        >;
                };

                pinctrl_flexcan1: flexcan1grp{
                        fsl,pins = <
                                MX6UL_PAD_LCD_DATA08__FLEXCAN1_TX 0x1b020
                                MX6UL_PAD_LCD_DATA09__FLEXCAN1_RX 0x1b020
                        >;
                };

                pinctrl_hog_1: hoggrp-1 {
                        fsl,pins = <
                                // LEDs
                                MX6UL_PAD_GPIO1_IO00__GPIO1_IO00 0x17099
                                MX6UL_PAD_GPIO1_IO01__GPIO1_IO01 0x17099
                                MX6UL_PAD_GPIO1_IO02__GPIO1_IO02 0x17099
                                MX6UL_PAD_GPIO1_IO08__GPIO1_IO08 0x17099
                                MX6UL_PAD_GPIO1_IO09__GPIO1_IO09 0x17099

                                // Digital outputs
                                MX6UL_PAD_JTAG_TDO__GPIO1_IO12    0x17099
                                MX6UL_PAD_JTAG_TCK__GPIO1_IO14    0x17099
                                MX6UL_PAD_UART2_CTS_B__GPIO1_IO22 0x17099
                                MX6UL_PAD_UART3_CTS_B__GPIO1_IO26 0x17099

                                // Digital inputs
                                MX6UL_PAD_LCD_RESET__GPIO3_IO04  0x99
                                MX6UL_PAD_LCD_DATA00__GPIO3_IO05 0x99
                                MX6UL_PAD_LCD_DATA01__GPIO3_IO06 0x99
                                MX6UL_PAD_LCD_DATA06__GPIO3_IO11 0x99

                                // Relay output
                                MX6UL_PAD_JTAG_TMS__GPIO1_IO11    0x17099
                                MX6UL_PAD_JTAG_TRST_B__GPIO1_IO15 0x17099
                        >;
                };

                pinctrl_i2c1: i2c1grp {
                        fsl,pins = <
                                MX6UL_PAD_UART4_TX_DATA__I2C1_SCL 0x4001b8b0
                                MX6UL_PAD_UART4_RX_DATA__I2C1_SDA 0x4001b8b0
                        >;
                };

                pinctrl_rtc_int: rtcgrp {
                        fsl,pins = <
                                MX6UL_PAD_UART3_RX_DATA__GPIO1_IO25 0x1b001
                        >;
                };

                pinctrl_uart1: uart1grp {
                        fsl,pins = <
                                MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX 0x1b0b1
                                MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX 0x1b0b1
                        >;
                };

                pinctrl_uart4: uart4grp {
                        fsl,pins = <
                                MX6UL_PAD_LCD_CLK__UART4_DCE_TX    0x1b0b1
                                MX6UL_PAD_LCD_ENABLE__UART4_DCE_RX 0x1b0b1
                        >;
                };

                pinctrl_uart5: uart5grp {
                        fsl,pins = <
                                MX6UL_PAD_UART5_TX_DATA__UART5_DCE_TX 0x1b0b1
                                MX6UL_PAD_UART5_RX_DATA__UART5_DCE_RX 0x1b0b1
                                MX6UL_PAD_UART1_CTS_B__GPIO1_IO18     0x1b0b0 
                        >;
                };

                pinctrl_uart8: uart8grp {
                        fsl,pins = <
                                MX6UL_PAD_ENET2_TX_EN__UART8_DTE_TX    0x1b0b1
                                MX6UL_PAD_ENET2_TX_DATA1__UART8_DTE_RX 0x1b0b1
                        >;
                };

                pinctrl_usb_otg1_vbus_en: usbotg1vbusengrp {
                        fsl,pins = <
                                MX6UL_PAD_GPIO1_IO04__GPIO1_IO04 0x10b0
                        >;
                };

                pinctrl_usb_otg1_id: usbotg1idgrp {
                        fsl,pins = <
                                MX6UL_PAD_UART3_TX_DATA__ANATOP_OTG1_ID 0x17059
                        >;
                };
        };
};
