	pinctrl_eqos_phyctrl: eqosgrp_phyctrl {
		fsl,pins = <
			MX91_PAD_CCM_CLKO3__GPIO4_IO28				0x31e	/* RESET */
			MX91_PAD_CCM_CLKO4__GPIO4_IO29				0x31e	/* interrupt */
		>;
